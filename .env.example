# ── Neo4j ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ── SQLite (user accounts, dev) ──
DATABASE_URL=sqlite+aiosqlite:///./graphtutor.db

# ── Redis (Celery broker + cache) ──
REDIS_URL=redis://localhost:6379/0

# ── Auth ──
SECRET_KEY=generate-a-random-64-char-string-for-graphtutor-jwt-secret-key-12345

# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_placeholder_token

# ── LLM APIs ──
ANTHROPIC_API_KEY=sk-ant-placeholder
OPENAI_API_KEY=sk-placeholder              # Whisper only

# ── Hostinger KV2 ──
KV2_ENDPOINT=https://your-kv2-endpoint
KV2_TOKEN=your-kv2-auth-token

# ── Model Routing ──
MODEL_EXTRACT=claude-haiku-4-5-20251001
MODEL_TEACH=claude-sonnet-4-6-20260901
MODEL_COMPLEX=claude-opus-4-6
MODEL_VISION=claude-sonnet-4-6-20260901

# ── App ──
LOG_LEVEL=INFO
ENVIRONMENT=development
